// 王国保卫战 Dove 版更新器配置（JSONC：可写注释，也能有多余的尾逗号）
// 优先级：命令行参数 > 环境变量 KRD_* > 本文件 > 内置默认值
// 相对路径都相对「本文件所在目录」解析，支持 ${ENV_VAR} 与 ~ 前缀。
{
  // 游戏安装目录，选到含 main.lua 与 _assets 的那一层。留空则自动探测常见位置。
  "install_dir": "",

  // 更新源，按顺序探测，第一个可用的胜出（官方镜像，通常不用改）
  "sites": [
    "https://krdovedownload4.crazyspotteddove.top/",
    "https://krdovedownload6.crazyspotteddove.top:52000/"
  ],

  "timeout_seconds": 60,        // 单次 HTTP 请求超时
  "retries": 4,                 // 网络失败重试次数（指数退避）
  "retry_backoff_seconds": 2,   // 退避基数：2s、4s、8s……
  "parallel_downloads": 4,      // 打包失效时逐文件下载的并发数

  // 服务端会把多个文件打成一个 zip 下发，文件多了自动分批
  "max_bundle_bytes": 20971520, // 每批的原始文件总大小上限（20MB）
  "max_bundle_files": 200,      // 每批文件个数上限

  "skip_assets": false,         // true = 只更新代码和数据，跳过美术音频
  "delete_removed": true,       // 是否删除服务端标记为删除的文件

  "backup": {
    "enabled": false,           // true = 覆盖前把旧文件备份一份（占空间，但能回滚）
    "dir": ""                   // 空 = 安装目录旁的 KRD_backup_<时间>
  },

  "temp_dir": "",               // 下载与解压的临时目录，空 = 系统临时目录
  "keep_temp": false,           // 出问题时设为 true，保留临时文件便于排查
  "log_file": "",               // 空 = 只输出到终端
  "user_agent": "KRD-Dove-Updater-Go/1.0",
  "proxy": "",                  // 例如 http://127.0.0.1:7890，空 = 依次看环境变量
  "insecure_tls": false,        // 只给用自签证书的私有镜像

  // 以下两项一般不用动，除非服务端改了协议
  "hash_file": "current_version_commit_hash.txt",
  "index_file": "_assets/assets_index.lua",

  "elevate": true,              // 目录不可写时自动请求管理员权限
  "progress": "auto",           // auto（终端里显示进度条）| plain | none
  "json_output": false,         // true = 结果以 JSON 输出，便于脚本解析
  "assume_yes": false,          // true = 不再询问确认
  "verbose": false
}
